APP_NAME="KhmerTopUp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.khmertopup.example

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=topup_production
DB_USERNAME=topup_prod_user
DB_PASSWORD=REPLACE_WITH_VAULT_SECRET

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_VAULT_SECRET
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# ProductionSafetyGuard strictly blocks mock providers when false
TOPUP_ALLOW_MOCKS_IN_PRODUCTION=false
TOPUP_PAYMENT_PROVIDER=aba_payway
ABA_PAYWAY_ENV=live
ABA_PAYWAY_BASE_URL=https://checkout.payway.com.kh
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_WEBHOOK_SECRET=

KAS_PLAY_BASE_URL=
KAS_PLAY_API_KEY=
KAS_PLAY_API_SECRET=
UNIPIN_BASE_URL=
UNIPIN_PARTNER_ID=
UNIPIN_SECRET_KEY=

SENTRY_LARAVEL_DSN=
CORS_ALLOWED_ORIGINS=https://khmertopup.example,https://admin.khmertopup.example
