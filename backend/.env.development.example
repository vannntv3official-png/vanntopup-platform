APP_NAME="KhmerTopUp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=sqlite
# For Docker / PostgreSQL local dev:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=topup_platform
# DB_USERNAME=topup_user
# DB_PASSWORD=topup_secret

QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file

TOPUP_ALLOW_MOCKS_IN_PRODUCTION=false
TOPUP_PAYMENT_PROVIDER=mock_payway
TOPUP_SUPPLIER_MODE=mock
TOPUP_EXCHANGE_RATE_USD_TO_KHR=4100
TOPUP_MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
